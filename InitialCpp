class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int temp = 0;
        bool in =false;
        sort(nums.begin(), nums.end());
        for(int i = 0; i < nums.size(); i++){
            cout << nums [i];
            temp = i;
            if(nums[i] != i){
                in = true;
                break;
            }
        }
        if(in == true){
            return temp;
        }
        else{
            return temp+1;
        }
    }
};
